# Configure as local .dev.vars or Cloudflare Pages secrets. Never commit real values.
THREADS_APP_ID=replace_with_numeric_threads_app_id
THREADS_APP_SECRET=replace_with_server_side_secret
THREADS_REDIRECT_URI=https://your-domain.pages.dev/oauth/callback
# Optional; if omitted, THREADS_APP_SECRET is used only as key material for encrypted ephemeral cookies.
OAUTH_SESSION_KEY=replace_with_at_least_32_random_characters
